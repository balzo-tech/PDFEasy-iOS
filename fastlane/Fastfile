default_platform(:ios)

# --- Project-wide constants -------------------------------------------------
XCODEPROJ           = "pdfexpert.xcodeproj"
PRODUCTION_SCHEME   = "PdfExpert"
STAGING_SCHEME      = "PdfExpert Staging"
PRODUCTION_CONFIG   = "Production Release"
STAGING_CONFIG      = "Staging Debug"
PRODUCTION_BUNDLE_ID = "eu.balzo.pdfexpert"

# Build configurations are non-standard in this project: Staging/Production × Debug/Release.
# There is no plain "Debug"/"Release" — passing one makes xcodebuild silently fall back to
# "Production Release", so always pass an explicit configuration above.

platform :ios do

  # --- CI -------------------------------------------------------------------
  desc "Compile the Staging app for the simulator (no signing). Fast CI sanity check."
  lane :ci_build do
    build_app(
      project: XCODEPROJ,
      scheme: STAGING_SCHEME,
      configuration: STAGING_CONFIG,
      destination: "generic/platform=iOS Simulator",
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      derived_data_path: "DerivedData",
      xcargs: "CODE_SIGNING_ALLOWED=NO ONLY_ACTIVE_ARCH=YES"
    )
  end

  desc "Check that user-facing text is localizable and the translations are intact"
  lane :lint do
    sh("python3", "../pdfexpert/Scripts/localization_lint.py")
  end

  desc "Run the test suite (unit + UI) on a simulator"
  lane :test do
    # Cheap and fails fast: no point compiling if a string was left untranslated.
    lint
    run_tests(
      project: XCODEPROJ,
      scheme: STAGING_SCHEME,
      configuration: STAGING_CONFIG,
      devices: ["iPhone 17 Pro"], # adjust to a simulator available on your machine / CI
      code_coverage: true,
      # Ad-hoc signing rather than no signing at all. Skipping it leaves the host
      # app without its iCloud entitlement, and the first Core Data access brings
      # it down before a single test runs — which reads as a crash in the app and
      # is not one. Signing with "-" costs nothing and keeps the entitlements.
      xcargs: 'CODE_SIGN_IDENTITY="-" CODE_SIGNING_REQUIRED=YES CODE_SIGNING_ALLOWED=YES ONLY_ACTIVE_ARCH=YES'
    )
  end

  # --- Distribution ---------------------------------------------------------
  desc "Build a signed Production archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
    increment_build_number(xcodeproj: XCODEPROJ)
    build_app(
      project: XCODEPROJ,
      scheme: PRODUCTION_SCHEME,
      configuration: PRODUCTION_CONFIG,
      export_method: "app-store"
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: PRODUCTION_BUNDLE_ID,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build a signed Production archive and upload it to App Store Connect (no auto-submit)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
    build_app(
      project: XCODEPROJ,
      scheme: PRODUCTION_SCHEME,
      configuration: PRODUCTION_CONFIG,
      export_method: "app-store"
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: PRODUCTION_BUNDLE_ID,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # --- Metadata -------------------------------------------------------------
  desc "Upload the App Store description and release notes, in every language"
  lane :metadata do
    # The store listing is localized into fourteen languages. Retyping two text
    # fields into a web form twenty-eight times is how a locale ends up a
    # release behind — or, worse, still carrying a sentence that stopped being
    # true. The texts live in fastlane/metadata/<locale>/ and are reviewed like
    # code; this lane is the only thing that writes them upstream.
    #
    # Options are in fastlane/Deliverfile. What matters there: no binary, no
    # screenshots, no submission. This lane cannot change what ships.
    upload_to_app_store(
      api_key: app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_FILEPATH")
      )
    )
  end

  desc "Show what `metadata` would upload, without contacting Apple"
  lane :metadata_check do
    # Reads the same files the upload does and reports what it found, so a
    # missing locale or a description over the 4000-character limit is caught
    # here rather than halfway through a run.
    limits = { "description" => 4000, "release_notes" => 4000 }
    dir = File.expand_path("metadata", __dir__)
    Dir.children(dir).sort.each do |locale|
      path = File.join(dir, locale)
      next unless File.directory?(path)
      limits.each_key do |field|
        file = File.join(path, "#{field}.txt")
        unless File.exist?(file)
          UI.important("#{locale}/#{field}.txt — missing, this locale keeps what is on App Store Connect")
          next
        end
        size = File.read(file).length
        if size > limits[field]
          UI.user_error!("#{locale}/#{field}.txt — #{size} characters, over the #{limits[field]} limit")
        end
        UI.success("#{locale}/#{field}.txt — #{size} characters")
      end
    end
  end
end
