default_platform(:ios)

# --- Project-wide constants -------------------------------------------------
XCODEPROJ           = "pdfexpert.xcodeproj"
PRODUCTION_SCHEME   = "PdfExpert"
STAGING_SCHEME      = "PdfExpert Staging"
PRODUCTION_CONFIG   = "Production Release"
STAGING_CONFIG      = "Staging Debug"
PRODUCTION_BUNDLE_ID = "eu.balzo.pdfexpert"

# Build configurations are non-standard in this project: Staging/Production × Debug/Release.
# There is no plain "Debug"/"Release" — passing one makes xcodebuild silently fall back to
# "Production Release", so always pass an explicit configuration above.

platform :ios do

  # --- CI -------------------------------------------------------------------
  desc "Compile the Staging app for the simulator (no signing). Fast CI sanity check."
  lane :ci_build do
    build_app(
      project: XCODEPROJ,
      scheme: STAGING_SCHEME,
      configuration: STAGING_CONFIG,
      destination: "generic/platform=iOS Simulator",
      skip_archive: true,
      skip_codesigning: true,
      skip_package_ipa: true,
      derived_data_path: "DerivedData",
      xcargs: "CODE_SIGNING_ALLOWED=NO ONLY_ACTIVE_ARCH=YES"
    )
  end

  desc "Check that user-facing text is localizable and the translations are intact"
  lane :lint do
    sh("python3", "../pdfexpert/Scripts/localization_lint.py")
  end

  desc "Run the test suite (unit + UI) on a simulator"
  lane :test do
    # Cheap and fails fast: no point compiling if a string was left untranslated.
    lint
    run_tests(
      project: XCODEPROJ,
      scheme: STAGING_SCHEME,
      configuration: STAGING_CONFIG,
      devices: ["iPhone 17 Pro"], # adjust to a simulator available on your machine / CI
      code_coverage: true,
      # Ad-hoc signing rather than no signing at all. Skipping it leaves the host
      # app without its iCloud entitlement, and the first Core Data access brings
      # it down before a single test runs — which reads as a crash in the app and
      # is not one. Signing with "-" costs nothing and keeps the entitlements.
      xcargs: 'CODE_SIGN_IDENTITY="-" CODE_SIGNING_REQUIRED=YES CODE_SIGNING_ALLOWED=YES ONLY_ACTIVE_ARCH=YES'
    )
  end

  desc "Run the unit tests on Mac Catalyst"
  lane :test_mac do
    lint
    # ⚠️ **No shortcut on signing works here**, and both were tried on 2026-08-27:
    # `CODE_SIGNING_ALLOWED=NO` builds but does not run — macOS refuses to load
    # Lottie.framework with "Trying to load an unsigned library" — and ad-hoc
    # signing (`CODE_SIGN_IDENTITY="-"`, which is what the iOS lane uses on a
    # simulator) is rejected by the entitlements: iCloud and App Groups "require
    # signing with a development certificate".
    #
    # So this signs for real. `-allowProvisioningUpdates` is what makes it work
    # from a terminal: the Mac Catalyst profiles are already in Xcode's cache,
    # and without the flag xcodebuild will not go looking for them.
    #
    # PDFPRO_DISABLE_CLOUDKIT reaches the app as TEST_RUNNER_ — that prefix is
    # how xcodebuild passes an environment variable through to the app under
    # test rather than to the runner.
    sh("xcodebuild", "test",
       "-project", "../#{XCODEPROJ}",
       "-scheme", STAGING_SCHEME,
       "-configuration", STAGING_CONFIG,
       "-destination", "platform=macOS,variant=Mac Catalyst,arch=arm64",
       "-derivedDataPath", "../DerivedData",
       "-allowProvisioningUpdates",
       "TEST_RUNNER_PDFPRO_DISABLE_CLOUDKIT=1",
       "-only-testing:PdfExpertTests")
  end

  # --- Distribution ---------------------------------------------------------
  desc "Build a signed Production archive and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
    increment_build_number(xcodeproj: XCODEPROJ)
    build_app(
      project: XCODEPROJ,
      scheme: PRODUCTION_SCHEME,
      configuration: PRODUCTION_CONFIG,
      export_method: "app-store"
    )
    upload_to_testflight(
      api_key: api_key,
      app_identifier: PRODUCTION_BUNDLE_ID,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build a signed Production archive and upload it to App Store Connect (no auto-submit)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
    build_app(
      project: XCODEPROJ,
      scheme: PRODUCTION_SCHEME,
      configuration: PRODUCTION_CONFIG,
      export_method: "app-store"
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: PRODUCTION_BUNDLE_ID,
      # ⚠️ **Not optional, and not obvious**: the Deliverfile sets
      # `skip_binary_upload(true)` — right for the text lanes, which run
      # unattended and must not be able to change what ships. deliver reads that
      # file here too, so without this line the lane archives, exports an ipa,
      # says "finished successfully" and uploads nothing but the metadata. That
      # is exactly what happened on 2026-08-27.
      skip_binary_upload: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Upload an ipa that has already been built, without archiving again"
  lane :upload_ipa do |options|
    # The archive takes minutes and the upload can fail on its own — a network
    # drop, a duplicate build number, a certificate. Rebuilding an identical
    # binary to retry an upload is waste, so the two halves can be run apart.
    upload_to_app_store(
      api_key: app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_FILEPATH")
      ),
      app_identifier: PRODUCTION_BUNDLE_ID,
      ipa: options[:ipa] || "PdfExpert.ipa",
      skip_binary_upload: false,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  # ⚠️ **This lane archives but cannot yet export**, and the reason is an account
  # permission rather than anything in the project. Distributing on the Mac App
  # Store needs two certificates iOS does not — "Mac App Distribution" and "Mac
  # Installer Distribution", the second to sign the .pkg — and neither exists in
  # the keychain. Asking xcodebuild to make them with -allowProvisioningUpdates
  # and the App Store Connect key answers "Cloud signing permission error": the
  # key can upload builds, not mint certificates.
  #
  # Two ways out, both a person's to take:
  #   - Xcode → Organizer → Distribute App on the archive this lane leaves in
  #     ~/Library/Developer/Xcode/Archives/. Signed in as the account holder,
  #     Xcode creates both certificates itself;
  #   - or create them once on developer.apple.com, after which this lane runs
  #     end to end.
  # The archive step works and is worth keeping: it is the slow half.
  desc "Build a signed Mac Catalyst archive and upload it to App Store Connect (no auto-submit)"
  lane :release_mac do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: ENV["ASC_KEY_FILEPATH"]
    )
    # Same target, same bundle id, same version — Universal Purchase means the
    # Mac build is a second binary on the same App Store record, not a second
    # app. What changes is the destination and the export method: `mac-application`
    # would produce something to hand out directly; the store wants `app-store`.
    build_app(
      project: XCODEPROJ,
      scheme: PRODUCTION_SCHEME,
      configuration: PRODUCTION_CONFIG,
      destination: "generic/platform=macOS,variant=Mac Catalyst",
      catalyst_platform: "macos",
      export_method: "app-store",
      output_name: "PdfExpert-mac"
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: PRODUCTION_BUNDLE_ID,
      platform: "osx",
      # Text and pictures go up with `metadata_mac` and `screenshots_mac`, by a
      # person who meant to send them. This lane carries the binary and nothing
      # else.
      skip_metadata: true,
      skip_screenshots: true,
      # See the note in `release`: the Deliverfile skips the binary, and without
      # this the lane would upload nothing at all.
      skip_binary_upload: false,
      pkg: "PdfExpert-mac.pkg",
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  # --- Metadata -------------------------------------------------------------
  desc "Upload the App Store description and release notes, in every language"
  lane :metadata do
    # The store listing is localized into fourteen languages. Retyping two text
    # fields into a web form twenty-eight times is how a locale ends up a
    # release behind — or, worse, still carrying a sentence that stopped being
    # true. The texts live in fastlane/metadata/<locale>/ and are reviewed like
    # code; this lane is the only thing that writes them upstream.
    #
    # Options are in fastlane/Deliverfile. What matters there: no binary, no
    # screenshots, no submission. This lane cannot change what ships.
    #
    # ⚠️ `app_version` is not optional here, however much it looks it. Without
    # it deliver works out which version it is writing to by picking up whatever
    # .ipa happens to be lying in the project root — the *previous* release, if
    # one was exported there — and then tries to create that version again. What
    # comes back is "The version number has been previously used", an error
    # about a version nobody asked it to touch. Read it from the project, which
    # is the same place the build gets it from.
    upload_to_app_store(
      api_key: app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_FILEPATH")
      ),
      app_version: marketing_version
    )
  end

  desc "Upload the Mac screenshots (and nothing else)"
  lane :screenshots_mac do
    # Deliberately a lane of its own, and deliberately not part of `metadata_mac`:
    # the Deliverfile keeps `skip_screenshots(true)` so an unattended text upload
    # can never hand a language ten more slides. Pictures go up when someone
    # means to send pictures.
    #
    # ⚠️ `overwrite_screenshots` is true here, unlike the Deliverfile default.
    # The Mac slot tops out at ten and deliver *adds*: running this twice without
    # it leaves eight slides where four were meant to be. True replaces the set,
    # which is what re-running a screenshot upload is for.
    upload_to_app_store(
      api_key: app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_FILEPATH")
      ),
      platform: "osx",
      screenshots_path: File.expand_path("screenshots-mac", __dir__),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
      app_version: marketing_version
    )
  end

  desc "Show what `metadata` would upload, without contacting Apple"
  lane :metadata_check do
    # Reads the same files the upload does and reports what it found, so a
    # missing locale or a description over the 4000-character limit is caught
    # here rather than halfway through a run.
    # promotional_text is the short one, and the only field here that can be
    # changed without shipping a version.
    limits = { "description" => 4000, "release_notes" => 4000, "promotional_text" => 170 }
    dir = File.expand_path("metadata", __dir__)
    Dir.children(dir).sort.each do |locale|
      path = File.join(dir, locale)
      next unless File.directory?(path)
      limits.each_key do |field|
        file = File.join(path, "#{field}.txt")
        unless File.exist?(file)
          UI.important("#{locale}/#{field}.txt — missing, this locale keeps what is on App Store Connect")
          next
        end
        size = File.read(file).length
        if size > limits[field]
          UI.user_error!("#{locale}/#{field}.txt — #{size} characters, over the #{limits[field]} limit")
        end
        UI.success("#{locale}/#{field}.txt — #{size} characters")
      end
    end
  end

  # --- Metadata, macOS -----------------------------------------------------
  desc "Upload the macOS store listing, in every language"
  lane :metadata_mac do
    # Same app, second store page. With Universal Purchase the Mac listing is a
    # page of its own — its own description, its own release notes, its own
    # screenshots — and it starts out empty: adding the platform on App Store
    # Connect copies the keywords across and nothing else.
    #
    # The texts live in fastlane/metadata-mac/, built from the iOS ones by
    # rewriting the seven lines that would be false on a Mac (see the header of
    # the generator). Everything else is word for word the reviewed iOS text, so
    # the two pages tell the same story.
    #
    # Options come from fastlane/Deliverfile, as for iOS: no binary, no
    # screenshots, no submission. `platform` is what sends this to the Mac page
    # rather than the iPhone one.
    #
    # ⚠️ The release notes do not go up, and that is not a bug here: this is the
    # first version on the platform, and App Store Connect answers a write to
    # `whatsNew` with 409 STATE_ERROR, "cannot be edited at this time" — there is
    # nothing to be new against. The texts stay in metadata-mac/ for the second
    # Mac version, which will take them.
    #
    # ⚠️ Nor does `app_version` create a version that is not there: the Mac page
    # is born as 1.0 and deliver writes into whatever is open for editing. Ours
    # was moved to 1.28 with a PATCH on /v1/appStoreVersions before uploading a
    # binary, because the version has to match what ships.
    upload_to_app_store(
      api_key: app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_filepath: ENV.fetch("ASC_KEY_FILEPATH")
      ),
      platform: "osx",
      metadata_path: File.expand_path("metadata-mac", __dir__),
      # Without this deliver writes to whichever version is open for editing on
      # the Mac page — and that page starts life at 1.0, a number that belongs to
      # no binary. The version has to match what gets uploaded, so it is read
      # from the project rather than typed here.
      app_version: marketing_version
    )
  end

  desc "Show what `metadata_mac` would upload, without contacting Apple"
  lane :metadata_mac_check do
    limits = { "description" => 4000, "release_notes" => 4000, "promotional_text" => 170 }
    dir = File.expand_path("metadata-mac", __dir__)
    Dir.children(dir).sort.each do |locale|
      path = File.join(dir, locale)
      next unless File.directory?(path)
      limits.each_key do |field|
        file = File.join(path, "#{field}.txt")
        unless File.exist?(file)
          UI.important("#{locale}/#{field}.txt — missing, this locale keeps what is on App Store Connect")
          next
        end
        size = File.read(file).length
        if size > limits[field]
          UI.user_error!("#{locale}/#{field}.txt — #{size} characters, over the #{limits[field]} limit")
        end
        UI.success("#{locale}/#{field}.txt — #{size} characters")
      end
    end
  end
end

# The version number, from the one place that agrees with the binary.
#
# ⚠️ Not `get_version_number`. This project keeps its version in build settings
# and has no Info.plist on disk, so that action falls back to the template
# default — **1.0.0** — without a word about it. deliver believes what it is
# given and `skip_app_version_update` is false, so what follows is not an error:
# it is "Successfully set the version to '1.0.0'" and an App Store Connect
# version that has quietly stopped being 1.30. That happened on 2026-09-01 and
# had to be patched back by hand through the API.
def marketing_version
  settings = sh("xcodebuild -showBuildSettings -project ../#{XCODEPROJ} " \
                "-target PdfExpert -configuration '#{PRODUCTION_CONFIG}' 2>/dev/null",
                log: false)
  version = settings[/^\s*MARKETING_VERSION\s*=\s*(.+)$/, 1]&.strip
  UI.user_error!("could not read MARKETING_VERSION from the project") if version.to_s.empty?
  version
end
