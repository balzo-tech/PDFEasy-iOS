# Materiale di lavorazione: si rigenera con ./make-screenshots.sh
build/
raw/
shots/
out/

# Lo stesso per il Mac, che si rifa' con ./mac-shots.sh
out-mac/

# Le catture dell'iPad si rifanno con ./ipad-ready.sh e il test; incoming/ tiene
# le immagini montate fuori di qui. Insieme fanno un centinaio di megabyte di
# PNG che non hanno niente da fare in un repository — la copia buona sta su App
# Store Connect. Il README di incoming/ resta, perche' dice dove vanno i file.
ipad-shots/
incoming/*/

# Il set di ottobre: catture e slide montate si rifanno con ./make-v2.sh e
# ./export-v2.sh. Si committano i sorgenti (index-v2.html, people/, photo-docs/,
# seed-docs/), non i PNG che ne escono.
raw-v2/
shots-v2/
out-v2/
