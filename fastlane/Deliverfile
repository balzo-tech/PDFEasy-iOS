# Metadata upload, text only.
#
# `fastlane metadata` reads fastlane/metadata/<locale>/{description,release_notes}.txt
# and writes them to the version that is open for editing on App Store Connect.
# Everything else on that page is left alone — screenshots, keywords, pricing,
# the build itself. Uploading text should not be able to change what ships.

app_identifier("eu.balzo.pdfexpert")

# The binary is uploaded by `fastlane beta`, not from here.
skip_binary_upload(true)

# Since 2026-08-02 the screenshots come from here too: fastlane/screenshots/
# holds a folder per language the app is translated into — en-US, it, es-MX,
# es-ES and, since 2026-08-20, de-DE — with the iPhone and the iPad set side by
# side in each. The languages without a folder have no screenshots of their own
# on App Store Connect: they inherit en-US, which is why leaving them out is not
# the same as blanking them.
#
# German ships five slides rather than six. The sixth is the chat, and it can
# only be shot on a phone with a live subscription (see
# screenshots-src/chat-material/): App Store takes anything from one to ten, so
# five real slides beat six with a placeholder in them.
skip_screenshots(false)

# Adds to what is on the page instead of replacing it. An upload cannot take
# away a slide that is already up there, which is the point: this lane runs
# unattended, and a folder that happens to be half-filled — a language mid-run,
# a device size not shot yet — would otherwise blank a set that a version cannot
# be submitted without.
#
# The price is that it also cannot re-upload: giving a language that already has
# its slides the same six again adds six more, and the slot tops out at ten. To
# change a set that is already up there, clear it on App Store Connect first, or
# upload that one language on its own with the `only` option of the lane.
overwrite_screenshots(false)
skip_app_version_update(false)

# No HTML preview waiting for a keypress: this lane has to run unattended.
force(true)

# Submission is a separate decision, taken by a person.
submit_for_review(false)
automatic_release(false)

# precheck screens metadata for things that get a submission rejected. It runs
# before submitting — and this lane never submits, so it has nothing to guard.
# It also cannot read in-app purchases with an API key, only with an Apple ID
# login, so leaving it on means the upload finishes and the lane fails anyway.
run_precheck_before_submit(false)
precheck_include_in_app_purchases(false)

# Whatever has a .txt in fastlane/metadata/<locale>/ is ours; anything without
# one keeps what is on App Store Connect, so a locale we have not translated yet
# is left as it is rather than being blanked.
#
# Since 2026-08-02 that is five fields, not two: name, subtitle and keywords
# joined description and release_notes. Until then the page was called
# "PDF Pro Scan Image & Documents" and subtitled "Convert, Edit, Read & Sign
# PDF" in all fourteen languages, English included where it belonged and not
# where it did not — the two fields search weighs most, in English, on an
# Italian or Korean store page.
#
# Name, subtitle and keywords are frozen while a version is in review: they go
# up with the next version that is still editable.
