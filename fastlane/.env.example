# Copy to fastlane/.env and fill in. That file is git-ignored; fastlane loads it
# by itself, so no shell profile needs to know about any of this.
#
# The key is created in App Store Connect → Users and Access → Integrations →
# App Store Connect API → Team Keys, with the App Manager role: a Developer key
# can read metadata but not write it. The .p8 downloads once and once only.
#
# Keep the .p8 outside this repository. A key in the repo is a key in every
# clone of it — the same reason proxy/.secrets/ exists and is ignored.

# The 10-character id shown in the key's row
ASC_KEY_ID=

# Issuer id, at the top of the same page — one per team, shared by every key
ASC_ISSUER_ID=

# Absolute path to the downloaded .p8
ASC_KEY_FILEPATH=/Users/you/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Used by the beta and release lanes, not by the metadata ones
FASTLANE_APPLE_ID=
