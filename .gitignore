#
# Pods/

# Carthage
#
# Add this line if you want to avoid checking in source code from Carthage dependencies.
# Carthage/Checkouts

Carthage/Build

# Firebase
PdfExpert/**/GoogleService-Info.plist
# Info Plist
PdfExpert/**/Info.plist
# ProjectInfo Plist
PdfExpert/**/ProjectInfo.plist
# Generated secrets (produced by the "Generate Secrets" build phase from the git-ignored ProjectInfo.plist)
pdfexpert/Generated/ObfuscatedSecrets.swift

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
# Lo stesso per il Mac: 2880x1800 l'una, e si rifanno con screenshots-src/mac-shots.sh
fastlane/screenshots-mac/**/*.png
fastlane/test_output
fastlane/README.md
# App Store Connect API credentials. fastlane loads fastlane/.env on its own,
# which is why the key ids live there and not in a shell profile. The .p8 itself
# belongs outside the repository entirely — see fastlane/.env.example.
fastlane/.env
fastlane/*.p8

# Serena MCP
.serena/

# Private keys kept next to the worker for convenience. The .p8 from App Store
# Connect lives here because Apple only lets you download it once, but it must
# never be committed: the whole point of the proxy is that the app ships without
# keys, and a key in the repository is a key in every clone of it. What the
# worker actually reads is the Cloudflare secret, uploaded from this file.
proxy/.secrets/

# App Store Server API key (an "In-App Purchase" key from Users and Access →
# Integrations — not the App Store Connect key in fastlane/, which cannot read
# subscriptions). It answers what no report answers in time: whether a trial
# converted, and how many minutes after starting it the renewal was switched off.
# Apple lets you download a key once, so the copy lives here and never leaves.
.secrets/

# Built app bundles. The archives themselves are already ignored above as .ipa
# and .dSYM; this catches the exported bundle that `build_app` and the debug
# capture leave in the working tree — 30 MB that look like source to git status.
*.app/
