    "Square like the American one, but measured from the crown rather than from the eyes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadratisch wie das amerikanische, aber vom Scheitel aus gemessen statt von den Augen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Square like the American one, but measured from the crown rather than from the eyes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuadrada como la estadounidense, pero medida desde la coronilla en lugar de desde los ojos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carrée comme l'américaine, mais mesurée depuis le sommet du crâne plutôt que depuis les yeux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quadrata come quella americana, ma misurata dalla sommità del capo invece che dagli occhi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vierkant zoals de Amerikaanse, maar gemeten vanaf de kruin in plaats van vanaf de ogen."
          }
        }
      }
    },
