    "Sizes follow each country's official rules. The office issuing your document has the final say.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Maße folgen den amtlichen Regeln des jeweiligen Landes. Das letzte Wort hat die ausstellende Behörde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizes follow each country's official rules. The office issuing your document has the final say."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las medidas siguen las normas oficiales de cada país. La última palabra la tiene la oficina que expide el documento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dimensions suivent les règles officielles de chaque pays. C'est le service qui délivre le document qui tranche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le misure seguono le regole ufficiali di ogni paese. L'ultima parola spetta all'ufficio che rilascia il documento."
          }
        }
      }
    },
