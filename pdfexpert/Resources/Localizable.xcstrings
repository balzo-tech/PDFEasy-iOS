          "stringUnit" : {
            "state" : "translated",
            "value" : "Measured to the crown without the hair, so tall hair does not count towards the 36 mm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se mide hasta la coronilla sin el pelo, así que el pelo alto no cuenta para los 36 mm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure va jusqu'au sommet du crâne sans les cheveux : une coiffure haute ne compte pas dans les 36 mm."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si misura fino alla sommità del capo senza i capelli, quindi i capelli alti non contano nei 36 mm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemeten tot de kruin zonder het haar, zodat hoog haar niet meetelt voor de 36 mm."
          }
        }
      }
    },
