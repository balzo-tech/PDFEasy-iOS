    "There is more than one face in this photo. An identity photo has to show one person alone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Foto ist mehr als ein Gesicht. Ein Passbild muss eine einzelne Person zeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is more than one face in this photo. An identity photo has to show one person alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En esta foto hay más de un rostro. Una foto de carné debe mostrar a una sola persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette photo contient plus d'un visage. Une photo d'identité doit montrer une seule personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questa foto c'è più di un viso. Una fototessera deve mostrare una persona sola."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er staat meer dan één gezicht op deze foto. Een pasfoto moet één persoon alleen tonen."
          }
        }
      }
    },
    "These are the names this file declares. The app does not check whether the signatures are still valid." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies sind die Namen, die diese Datei angibt. Die App prüft nicht, ob die Signaturen noch gültig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are the names this file declares. The app does not check whether the signatures are still valid."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos son los nombres que declara el archivo. La app no comprueba si las firmas siguen siendo válidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici les noms déclarés par ce fichier. L'application ne vérifie pas si les signatures sont toujours valides."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi sono i nomi dichiarati dal file. L'app non verifica se le firme sono ancora valide."
          }
        },
        "nl" : {
