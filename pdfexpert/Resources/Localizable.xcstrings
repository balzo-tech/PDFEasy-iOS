    "The head is shorter than elsewhere in Europe: 29–34 mm, not 32–36. A photo made to the EU rule is rejected here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kopf ist kürzer als im übrigen Europa: 29–34 mm statt 32–36. Ein nach EU-Regel erstelltes Foto wird hier abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The head is shorter than elsewhere in Europe: 29–34 mm, not 32–36. A photo made to the EU rule is rejected here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El rostro es más bajo que en el resto de Europa: 29–34 mm, no 32–36. Una foto hecha con la regla de la UE se rechaza aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le visage est plus court qu'ailleurs en Europe : 29–34 mm, et non 32–36. Une photo faite selon la règle de l'UE est refusée ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il viso è più basso che nel resto d'Europa: 29–34 mm, non 32–36. Una foto fatta con la regola UE qui viene respinta."
          }
        }
      }
    },
