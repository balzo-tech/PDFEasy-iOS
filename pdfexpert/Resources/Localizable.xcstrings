        }
      }
    },
    "A whole sheet to cut up. Take the image to a photo kiosk, or print the PDF **at actual size — 100%, not “fit to page”** — or the photos come out the wrong size." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ganzer Bogen zum Zerschneiden. Bringen Sie das Bild zum Fotoautomaten oder drucken Sie das PDF **in Originalgröße — 100 %, nicht „an Seite anpassen“** — sonst stimmt das Format nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A whole sheet to cut up. Take the image to a photo kiosk, or print the PDF **at actual size — 100%, not “fit to page”** — or the photos come out the wrong size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una hoja entera para recortar. Lleva la imagen a un kiosco de fotos, o imprime el PDF **a tamaño real — 100 %, no «ajustar a la página»** — o las fotos salen del tamaño equivocado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une planche entière à découper. Apportez l'image à une borne photo, ou imprimez le PDF **à taille réelle — 100 %, pas « ajuster à la page »** — sinon les photos sortent au mauvais format."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un foglio intero da ritagliare. Porta l'immagine a un chiosco fotografico, oppure stampa il PDF **a grandezza reale — 100%, non «adatta alla pagina»** — o le foto vengono della misura sbagliata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een heel vel om uit te knippen. Breng de afbeelding naar een fotokiosk of print de PDF **op ware grootte — 100%, niet “passend maken”** — anders krijgen de foto's het verkeerde formaat."
          }
        }
      }
    },
