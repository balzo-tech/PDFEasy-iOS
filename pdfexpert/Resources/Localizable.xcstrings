    "There is more than one face in this photo. An identity photo has to show one person alone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Foto ist mehr als ein Gesicht. Ein Passbild muss eine einzelne Person zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is more than one face in this photo. An identity photo has to show one person alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta foto hay más de un rostro. Una foto de carné debe mostrar a una sola persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo contient plus d'un visage. Une photo d'identité doit montrer une seule personne."
          }
        },
        "it": {
