            "state": "translated",
            "value": "Its own size, 33 × 48 mm, and a light blue backdrop is accepted alongside white."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiene su propio tamaño, 33 × 48 mm, y admite el azul claro además del blanco."
          }
        },
        "fr": {
