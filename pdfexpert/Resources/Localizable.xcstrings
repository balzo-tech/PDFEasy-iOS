    "It will look fine on paper, but a closer photo would be sharper." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf Papier reicht das, aber ein näheres Foto wäre schärfer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will look fine on paper, but a closer photo would be sharper."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En papel quedará bien, pero una foto más cercana sería más nítida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur papier ce sera correct, mais une photo plus rapprochée serait plus nette."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su carta andrà bene, ma una foto più ravvicinata sarebbe più nitida."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op papier ziet het er goed uit, maar een foto van dichterbij zou scherper zijn."
          }
        }
      }
    },
    "Its own size, 33 × 48 mm, and a light blue backdrop is accepted alongside white." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein eigenes Format, 33 × 48 mm, und neben Weiß ist auch Hellblau zulässig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its own size, 33 × 48 mm, and a light blue backdrop is accepted alongside white."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene su propio tamaño, 33 × 48 mm, y admite el azul claro además del blanco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un format à part, 33 × 48 mm, et le bleu clair est accepté en plus du blanc."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha una misura sua, 33 × 48 mm, e accetta l'azzurro oltre al bianco."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een eigen formaat, 33 × 48 mm, en naast wit wordt ook een lichtblauwe achtergrond geaccepteerd."
          }
        }
      }
    },
    "Japan states the head as 34 mm give or take 2 — the same window as the ICAO standard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japan gibt den Kopf mit 34 mm plus/minus 2 an — dasselbe Fenster wie der ICAO-Standard."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japan states the head as 34 mm give or take 2 — the same window as the ICAO standard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japón indica el rostro como 34 mm más o menos 2: la misma horquilla que el estándar ICAO."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Japon indique le visage à 34 mm à 2 mm près — la même fourchette que la norme OACI."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Giappone indica il viso come 34 mm più o meno 2 — la stessa finestra dello standard ICAO."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Japan geeft het hoofd aan als 34 mm plus of min 2 — hetzelfde bereik als de ICAO-norm."
          }
        }
      }
    },
