    "Copy protection is a convention that PDF readers choose to respect: it discourages copying but does not make the text unreadable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy protection is a convention that PDF readers choose to respect: it discourages copying but does not make the text unreadable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección contra copia es una convención que los lectores de PDF eligen respetar: desalienta la copia, pero no hace que el texto sea ilegible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La protezione dalla copia è una convenzione che i lettori PDF scelgono di rispettare: scoraggia la copia ma non rende il testo illeggibile."
