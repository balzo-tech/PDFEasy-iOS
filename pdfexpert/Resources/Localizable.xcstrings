          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il file PDF sul dispositivo. Puoi comunque visualizzarlo e condividerlo."
          }
        }
      }
    },
    "The permissions could not be applied to this PDF.": {
      "localizations": {
