    "You have denied permission to access the camera of your device. Please go to Settings to change your camera permission to be able to scan and convert your documents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben den Zugriff auf die Kamera Ihres Geräts verweigert. Bitte gehen Sie zu den Einstellungen und ändern Sie die Kameraberechtigung, um Ihre Dokumente scannen und konvertieren zu können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have denied permission to access the camera of your device. Please go to Settings to change your camera permission to be able to scan and convert your documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has denegado el permiso para acceder a la cámara de tu dispositivo. Ve a Ajustes para cambiar el permiso de la cámara y poder escanear y convertir tus documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez refusé l'accès à l'appareil photo de votre appareil. Allez dans Réglages pour modifier l'autorisation et pouvoir numériser et convertir vos documents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai negato il permesso di accedere alla fotocamera del tuo dispositivo. Vai in Impostazioni per modificare il permesso della fotocamera e poter scansionare e convertire i tuoi documenti."
          }
        }
      }
    },
    "You have denied permission to access the camera of your device. Please go to Settings to change your camera permission to be able to take pictures of your documents.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben den Zugriff auf die Kamera Ihres Geräts verweigert. Bitte gehen Sie zu den Einstellungen und ändern Sie die Kameraberechtigung, um Ihre Dokumente fotografieren zu können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have denied permission to access the camera of your device. Please go to Settings to change your camera permission to be able to take pictures of your documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has denegado el permiso para acceder a la cámara de tu dispositivo. Ve a Ajustes para cambiar el permiso de la cámara y poder fotografiar tus documentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez refusé l'accès à l'appareil photo de votre appareil. Allez dans Réglages pour modifier l'autorisation et pouvoir photographier vos documents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai negato il permesso di accedere alla fotocamera del tuo dispositivo. Vai in Impostazioni per modificare il permesso della fotocamera e poter fotografare i tuoi documenti."
          }
        }
      }
    },
