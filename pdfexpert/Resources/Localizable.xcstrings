    "System follows your Mac. The other two stay put, whatever the Mac does." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«System» folgt Ihrem Mac. Die anderen beiden bleiben, wie Sie sie wählen, ganz gleich was der Mac tut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System follows your Mac. The other two stay put, whatever the Mac does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sistema» sigue tu Mac. Las otras dos se quedan como las elijas, haga lo que haga el Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Système» suit votre Mac. Les deux autres restent comme vous les choisissez, quoi que fasse le Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sistema» segue il Mac. Gli altri due restano come li scegli, qualunque cosa faccia il Mac."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systeem volgt uw Mac. De andere twee blijven staan, wat de Mac ook doet."
          }
        }
      }
    },
    "System follows your phone. The other two stay put, whatever the phone does." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
