        }
      }
    },
    "Its own size, 33 × 48 mm, and a light blue backdrop is accepted alongside white.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein eigenes Format, 33 × 48 mm, und neben Weiß ist auch Hellblau zulässig."
          }
        },
