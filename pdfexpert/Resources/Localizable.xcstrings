    "Choose a plain background above and the app fills in what is missing — or move further from the camera and take it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie oben einen einfarbigen Hintergrund, dann füllt die App das Fehlende — oder gehen Sie weiter weg und fotografieren Sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a plain background above and the app fills in what is missing — or move further from the camera and take it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un fondo liso arriba y la app rellena lo que falta, o aléjate de la cámara y repite la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fond uni ci-dessus et l'app comble ce qui manque — ou éloignez-vous de l'appareil et reprenez la photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli uno sfondo uniforme qui sopra e l'app riempie quello che manca — oppure allontanati dalla fotocamera e rifai la foto."
          }
        }
      }
    },
    "Choose a plain background above and the app replaces it.": {
      "localizations": {
        "de": {
