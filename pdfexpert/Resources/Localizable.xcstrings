            "value": "No se han podido procesar las páginas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages n'ont pas pu être traitées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile elaborare le pagine."
          }
        }
      }
    },
    "The pages you have taken will be lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufgenommenen Seiten gehen verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pages you have taken will be lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perderán las páginas que has tomado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages que vous avez prises seront perdues."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine acquisite andranno perse."
          }
        }
      }
    },
    "The pdf file couldn't be saved on your device. You can still view it and share it.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die PDF-Datei konnte nicht auf Ihrem Gerät gespeichert werden. Sie können sie trotzdem ansehen und teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pdf file couldn't be saved on your device. You can still view it and share it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el archivo PDF en tu dispositivo. Aun así puedes verlo y compartirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
