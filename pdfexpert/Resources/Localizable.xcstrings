    "The one that goes on a résumé, a student card or an application form. Head height derived from ICAO's 70–80% rule.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Foto für Lebenslauf, Studierendenausweis oder Antragsformular. Die Kopfhöhe leitet sich aus der ICAO-Regel von 70–80 % ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one that goes on a résumé, a student card or an application form. Head height derived from ICAO's 70–80% rule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La que va en el currículum, en el carné de estudiante o en un formulario de solicitud. La altura del rostro se deriva de la regla ICAO del 70–80 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celle qui va sur un CV, une carte d'étudiant ou un formulaire de demande. La hauteur du visage découle de la règle OACI des 70–80 %."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella che va sul curriculum, sul tesserino dello studente o su un modulo di domanda. L'altezza del viso deriva dalla regola ICAO del 70–80%."
          }
        }
      }
    },
    "The pages could not be processed.": {
      "comment": "Error message when the scanner fails to process the pages.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seiten konnten nicht verarbeitet werden."
          }
        },
