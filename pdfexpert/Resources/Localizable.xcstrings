    "The pdf file couldn't be saved on your device. You can still view it and share it." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pdf file couldn't be saved on your device. You can still view it and share it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido guardar el archivo PDF en tu dispositivo. Aun así puedes verlo y compartirlo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare il file PDF sul dispositivo. Puoi comunque visualizzarlo e condividerlo."
          }
        }
      }
    },
    "The permissions could not be applied to this PDF." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The permissions could not be applied to this PDF."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido aplicar los permisos a este PDF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile applicare i permessi a questo PDF."
          }
        }
      }
    },
    "The redacted pages are converted into images: on those pages the text will no longer be selectable or searchable. A new copy is saved and your original is left untouched." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The redacted pages are converted into images: on those pages the text will no longer be selectable or searchable. A new copy is saved and your original is left untouched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las páginas censuradas se convierten en imágenes: en esas páginas el texto ya no se podrá seleccionar ni buscar. Se guarda una copia nueva y tu original queda intacto."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le pagine oscurate vengono convertite in immagini: su quelle pagine il testo non sarà più selezionabile né ricercabile. Viene salvata una nuova copia e l'originale resta intatto."
          }
        }
      }
    },
    "The share button, or \"Open in\" if the file offers that instead." : {
