          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not an identity document: this is the photo that goes on a Japanese job application, and it is what most people there are looking for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un documento de identidad: es la foto que va en la solicitud de empleo japonesa, y es la que allí busca la mayoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n'est pas un document d'identité : c'est la photo qui accompagne une candidature au Japon, et c'est celle que la plupart des gens y cherchent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è un documento d'identità: è la foto che va sulla domanda di lavoro giapponese, ed è quella che là cerca la maggior parte delle persone."
