    "Nothing to do with children — it is what the small Mexican document photo is called. Head height derived from ICAO's 70–80% rule.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat nichts mit Kindern zu tun — so heißt das kleine mexikanische Dokumentfoto. Die Kopfhöhe leitet sich aus der ICAO-Regel von 70–80 % ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to do with children — it is what the small Mexican document photo is called. Head height derived from ICAO's 70–80% rule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tiene nada que ver con niños: así se llama la foto de documento pequeña en México. La altura del rostro se deriva de la regla ICAO del 70–80 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à voir avec les enfants : c'est le nom de la petite photo de document mexicaine. La hauteur du visage découle de la règle OACI des 70–80 %."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ha nulla a che vedere con i bambini: è il nome della piccola foto documento messicana. L'altezza del viso deriva dalla regola ICAO del 70–80%."
          }
        }
      }
    },
