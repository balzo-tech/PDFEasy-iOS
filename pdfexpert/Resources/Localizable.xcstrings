    "Spain is the exception: 26 × 32 mm, not the 35 × 45 mm the rest of Europe uses. Head height derived from ICAO's 70–80% rule.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spanien ist die Ausnahme: 26 × 32 mm statt der 35 × 45 mm des übrigen Europas. Die Kopfhöhe leitet sich aus der ICAO-Regel von 70–80 % ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spain is the exception: 26 × 32 mm, not the 35 × 45 mm the rest of Europe uses. Head height derived from ICAO's 70–80% rule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "España es la excepción: 26 × 32 mm, no los 35 × 45 mm del resto de Europa. La altura del rostro se deriva de la regla ICAO del 70–80 %."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'Espagne fait exception : 26 × 32 mm, et non les 35 × 45 mm du reste de l'Europe. La hauteur du visage découle de la règle OACI des 70–80 %."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Spagna è l'eccezione: 26 × 32 mm, non i 35 × 45 mm del resto d'Europa. L'altezza del viso deriva dalla regola ICAO del 70–80%."
          }
        }
      }
    },
