          }
        }
      }
    },
    "The redacted pages are converted into images: on those pages the text will no longer be selectable or searchable. A new copy is saved and your original is left untouched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geschwärzten Seiten werden in Bilder umgewandelt: auf diesen Seiten ist der Text nicht mehr auswählbar oder durchsuchbar. Es wird eine neue Kopie gespeichert, Ihr Original bleibt unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The redacted pages are converted into images: on those pages the text will no longer be selectable or searchable. A new copy is saved and your original is left untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas censuradas se convierten en imágenes: en esas páginas el texto ya no se podrá seleccionar ni buscar. Se guarda una copia nueva y tu original queda intacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages caviardées sont converties en images : sur ces pages, le texte ne sera plus sélectionnable ni consultable. Une nouvelle copie est enregistrée et votre original reste intact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine oscurate vengono convertite in immagini: su quelle pagine il testo non sarà più selezionabile né ricercabile. Viene salvata una nuova copia e l'originale resta intatto."
          }
        }
      }
    },
    "The right size for your country, checked before you print": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das richtige Format für Ihr Land, vor dem Druck geprüft"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The right size for your country, checked before you print"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño correcto para tu país, comprobado antes de imprimir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bon format pour votre pays, vérifié avant l'impression"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La misura giusta per il tuo paese, controllata prima di stampare"
          }
        }
      }
    },
    "The same photo works for the passport, the electronic ID card and the driving licence.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Foto gilt für Reisepass, elektronischen Personalausweis und Führerschein."
          }
        },
