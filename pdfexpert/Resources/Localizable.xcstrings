    },
    "Japan states the head as 34 mm give or take 2 — the same window as the ICAO standard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan gibt den Kopf mit 34 mm plus/minus 2 an — dasselbe Fenster wie der ICAO-Standard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Japan states the head as 34 mm give or take 2 — the same window as the ICAO standard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Japón indica el rostro como 34 mm más o menos 2: la misma horquilla que el estándar ICAO."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Japon indique le visage à 34 mm à 2 mm près — la même fourchette que la norme OACI."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Giappone indica il viso come 34 mm più o meno 2 — la stessa finestra dello standard ICAO."
