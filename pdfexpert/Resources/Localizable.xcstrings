    "Copy protection is a convention that PDF readers choose to respect: it discourages copying but does not make the text unreadable.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopierschutz ist eine Übereinkunft, die PDF-Reader freiwillig beachten: er erschwert das Kopieren, macht den Text aber nicht unlesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy protection is a convention that PDF readers choose to respect: it discourages copying but does not make the text unreadable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La protección contra copia es una convención que los lectores de PDF eligen respetar: desalienta la copia, pero no hace que el texto sea ilegible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection contre la copie est une convention que les lecteurs PDF choisissent de respecter : elle décourage la copie mais ne rend pas le texte illisible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La protezione dalla copia è una convenzione che i lettori PDF scelgono di rispettare: scoraggia la copia ma non rende il testo illeggibile."
          }
        }
      }
    },
    "Could not verify this device. Check your connection and try again.": {
      "comment": "Error message when App Attest cannot be contacted.",
