            "value" : "Drehen Sie sich zum Licht oder stellen Sie sich dorthin, wo es beide Gesichtshälften erreicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn to face the light, or stand where it reaches both sides of your face."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gírate hacia la luz, o ponte donde llegue a ambos lados del rostro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez-vous vers la lumière, ou placez-vous là où elle atteint les deux côtés du visage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Girati verso la luce, o mettiti dove arriva su entrambi i lati del viso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draai naar het licht toe, of ga staan waar het beide kanten van uw gezicht bereikt."
          }
        }
      }
    },
